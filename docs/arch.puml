@startuml
!theme plain
skinparam backgroundColor #FEFEFE
skinparam componentStyle rectangle

' 组件类型配色：Agent(LLM 驱动) vs 机械结构(确定性程序)
skinparam component {
    BackgroundColor<<agent>> #FFE8CC
    BorderColor<<agent>> #CC7A00
    BackgroundColor<<mech>> #E3F2FD
    BorderColor<<mech>> #1565C0
}

title Oceanids

legend right
  |= 类型 |= 含义 |
  | <back:#FFE8CC>«agent»</back> | LLM 驱动，有判断力 |
  | <back:#E3F2FD>«mech»</back> | 机械结构：确定性程序，无 LLM |
endlegend

database "SQLite" as DB <<mech>> {
    rectangle "表1: candidate_issues\n(子代理原始输出 | 状态)" as T1
    rectangle "表2: confirmed_bugs\n(经 Probe 证实的真 Bug)" as T2
}

package "发现者" {
    [函数索引生成器\nAST/启发式解析] as FuncIndex <<mech>>
    [任务分发器\n规则切分] as Dispatch <<mech>>
    [Overview 文档代理\n写 overview.md] as OvGen <<agent>>
}

artifact "overview.md\n(.oceanids/)" as OvMd

package "子代理池" {
    [探索代理 1] as SA1 <<agent>>
    [探索代理 2] as SA2 <<agent>>
    [探索代理 3] as SA3 <<agent>>
}

package "验证者" {
    [Probe 生成器] as ProbeGen <<agent>>
    [Probe 审计员\n静态审查\n(不执行)] as Audit <<agent>>
    [沙箱执行引擎\n编译|运行|比对] as Sandbox <<mech>>
    [独立 Checker\n干净环境重跑\n只信自跑结果] as Checker <<mech>>
}

' Phase 0: 冻结快照（私有 index / copytree 降级）
[冻结快照\n私有 index 快照\ncopytree 降级] as Freeze <<mech>>
[目标代码库] --> Freeze
Freeze --> FuncIndex
FuncIndex --> Dispatch
FuncIndex --> OvGen
OvGen --> OvMd : 缺失→生成\n重试一次,仍无→报错退出
Dispatch --> SA1
Dispatch --> SA2
Dispatch --> SA3

' overview.md 注入后续所有 agent 的上下文
OvMd ..> SA1 : 注入上下文
OvMd ..> SA2 : 注入上下文
OvMd ..> SA3 : 注入上下文
OvMd ..> ProbeGen : 注入上下文
OvMd ..> Audit : 注入上下文

note right of Dispatch
  单函数单 agent:
  一次定终身
  成功才标记(落库可续跑)
  失败不烧机会
end note

SA1 --> T1 : INSERT\n(问题函数, 问题, 触发方法)
SA2 --> T1 : INSERT
SA3 --> T1 : INSERT

' 法一: 写入时键去重
note bottom of T1
  法一: 键去重
  UNIQUE(函数,CWE id)
  INSERT OR IGNORE
end note

' Phase 3: 验证者直接订阅表1
T1 --> ProbeGen : SELECT pending
ProbeGen --> Audit : Probe\n(输入/预期输出)
ProbeGen --> T1 : 结构化拒绝(refuse+reason)\n→ UPDATE(status='rejected',\nreject_reason=理由)

' Phase 3.4: 审计门（打回重写，耗尽则拒）
Audit --> ProbeGen : invalid → 打回重写\n(上限 probe_retries)
Audit --> T1 : 重写耗尽 → UPDATE\n(status='rejected')
Audit --> Sandbox : ok → 放行

' 硬约束（机械保证，非 prompt）
note right of Sandbox
  硬约束:
  仅公开符号链接
  冻结快照
  (漂移构造上不可能)
  sanitizer=oracle
end note

' Phase 3.5: 生成/执行/判定三权分离
Sandbox --> Checker : 执行证据

note right of Checker
  确认前置条件(缺一不可):
  1. SETUP 标记 → 依赖完整
  2. REACHED 标记 → 输入可达
  3. oracle 触发(exit!=0/超时/sanitizer)
  缺 SETUP → 计一次 verify_attempts
  缺 REACHED → 打回重写,耗尽则拒
end note

' Phase 4: 验证结果分流
Checker --> T2 : 真阳性 → INSERT 表2\n法二: 证据去重\n(top-3帧/违反点)
Checker --> T1 : 假阳性 → UPDATE\n(status='rejected')
Checker --> T1 : 无证据运行耗尽 verify_attempts\n→ UPDATE(status='inconclusive')\n(不判真不判假,可手动重置)

T2 --> [Bug 报告] : 全部经 Probe 证实

@enduml
